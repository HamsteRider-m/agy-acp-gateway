# ==============================================================================
# agy-acp-gateway Configuration Example (.env.example)
# Copy to .env and adjust values before starting the gateway or Docker container.
# ==============================================================================

# --- Authentication & Security ---
# Comma-separated API keys for /v1/*, /v1beta/*, and :18891 Dashboard / /metrics
# (Browser dashboard HTTP Basic Auth accepts any username with an API key as password;
#  leave empty ONLY on trusted localhost)
AGY_API_KEYS=sk-agy-replace-with-your-secret-key
# Optional newline-delimited API keys file (# comments allowed; merged with AGY_API_KEYS)
# AGY_API_KEYS_FILE=/path/to/api_keys.txt
# Optional comma-separated allowed CORS origins
AGY_CORS_ORIGINS=

# --- Network & Ports ---
AGY_LISTEN_HOST=127.0.0.1
AGY_GW_PORT=18890
AGY_DASH_PORT=18891

# --- Upstream ACP Binary & Proxy ---
# Path to the Gate 1-5 patched 900K context agy binary (linux_amd64 / linux_arm64 / darwin_arm64;
# default: <project_root>/bin/agy-acp-900k)
# AGY_ACP_BIN=/path/to/agy-acp-gateway/bin/agy-acp-900k
# Upstream HTTP/HTTPS proxy used by the agy ACP subprocess (set empty if direct connection)
AGY_UPSTREAM_PROXY=http://127.0.0.1:7890
# Set to 1 to allow consuming Google One AI credits when regular quota is exhausted
AGY_USE_G1_CREDITS=0

# --- Worker Pool & Session Lifecycle ---
AGY_MAX_LIVE_WORKERS=8
AGY_MAX_CONCURRENT_PROMPTS=6
AGY_MAX_PROBE_WORKERS=1
# Idle ACP session hibernation timeout in seconds (20m default, aligned with agy's 270s stateless keepalive)
AGY_IDLE_WORKER_TTL_SEC=1200
AGY_PARKED_TTL_SEC=300
AGY_MAX_TOOL_RELAYS=4
AGY_MAX_BODY_MB=64

# --- KV Cache Protection & Cleanroom ---
# Grace window before sending session/cancel on client abort after slow prefill (>30s)
AGY_PREFILL_CANCEL_MIN_ELAPSED_SEC=30
AGY_PREFILL_CANCEL_GRACE_SEC=45
# Non-blocking X-Agy-Cache-Warning threshold (minimum total tokens & consecutive zero-cache streak)
AGY_CACHE_WARN_MIN_TOKENS=80000
AGY_CACHE_WARN_STREAK=3
# Automatic upstream 400 WAF bisection & deterministic scrub fallback
AGY_WAF_AUTOBISECT=true
# AGY_WAF_RULES_FILE=/path/to/waf_rewrite_rules.json

# --- Model Exposure (optional) ---
# AGY_DEFAULT_MODEL=gemini-4-carbon
# AGY_EXPOSE_TIER_MODELS=0
# AGY_ROUTE_CLAUDE_NAMES=0

# --- Multimodal Pipeline & Maintenance ---
AGY_MAX_IMAGES_GEMINI=200
AGY_MAX_IMAGES_CLAUDE=100
AGY_MAX_IMAGE_BYTES=10485760
AGY_MAX_PROMPT_IMAGE_BYTES=33554432
AGY_MAX_TEXT_FILE_BYTES=2097152
AGY_FETCH_IMAGES=true
# Optional expired conversation DB cleanup in days (0 = disabled, default; gateway-owned conversations only)
AGY_CONV_KEEP_DAYS=0
# Optional read-only Antigravity Desktop App conversation telemetry directory
# (empty = auto-discover ~/.gemini/antigravity/conversations on local main instance; set "off" to disable)
AGY_APP_CONV_DIR=
